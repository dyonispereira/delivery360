{
  "name": "delivery360",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @delivery360/api prisma:migrate",
    "db:seed": "pnpm --filter @delivery360/api prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  }
}
