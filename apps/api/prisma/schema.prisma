// Núcleo (core) do Delivery360: restaurantes (tenants), módulos, planos, usuários,
// auditoria e fila de eventos entre módulos.
// Regra: toda tabela de negócio dos módulos terá a coluna tenant_id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum StaffRole {
  SUPER_ADMIN
  ACCOUNT_MANAGER
}

enum TenantRole {
  OWNER
  MANAGER
  STAFF
  /// Garçom: só vê o salão (mesas, prontos para servir e a conta da mesa).
  WAITER
}

/// Restaurante cliente. Cada um é isolado dos demais.
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  legalName String?      @map("legal_name")
  cnpj      String?      @unique
  phone     String?
  email     String?
  status    TenantStatus @default(ACTIVE)
  planId    String?      @map("plan_id") @db.Uuid
  plan      Plan?        @relation(fields: [planId], references: [id])
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  modules         TenantModule[]
  memberships     Membership[]
  accountManagers AccountManagerTenant[]
  auditLogs       AuditLog[]
  events          DomainEvent[]

  store            Store?
  paymentAccount   PaymentAccount?
  whatsappAccount  WhatsappAccount?
  deliveryZones    DeliveryZone[]
  menuCategories   MenuCategory[]
  products         Product[]
  customers        Customer[]
  orders           Order[]
  couriers         Courier[]
  deliveryBatches  DeliveryBatch[]
  accounts         Account[]
  financialEntries FinancialEntry[]
  financeSettings  FinanceSettings?
  channelSettings  ChannelSetting[]
  channelMerchants ChannelMerchant[]
  ifoodCatalogLinks IfoodCatalogLink[]
  channelEvents    ChannelEvent[]
  channelLinks     ChannelOrderLink[]
  employees        Employee[]
  payrolls         Payroll[]
  coupons          Coupon[]
  diningTables     DiningTable[]
  tableTabs        TableTab[]
  loyaltyProgram   LoyaltyProgram?
  loyaltyRewards   LoyaltyReward[]
  clubLevels       ClubLevel[]
  loyaltyMoves     LoyaltyTransaction[]
  cashSessions     CashSession[]
  counterPayments  CounterPayment[]
  fiscalSettings   FiscalSettings?
  fiscalDocuments  FiscalDocument[]
  totems           Totem[]

  @@map("tenants")
}

/// Catálogo de módulos (gestao, cardapio, entregas, trafego).
model Module {
  code        String  @id
  name        String
  description String?

  plans   PlanModule[]
  tenants TenantModule[]

  @@map("modules")
}

/// Plano comercial = pacote de módulos.
model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  modules PlanModule[]
  tenants Tenant[]

  @@map("plans")
}

model PlanModule {
  planId     String @map("plan_id") @db.Uuid
  moduleCode String @map("module_code")
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module     Module @relation(fields: [moduleCode], references: [code])

  @@id([planId, moduleCode])
  @@map("plan_modules")
}

/// A "chave" de cada módulo por restaurante. Desligar não apaga dados.
model TenantModule {
  tenantId   String    @map("tenant_id") @db.Uuid
  moduleCode String    @map("module_code")
  active     Boolean   @default(true)
  startsAt   DateTime? @map("starts_at")
  /// Fim opcional (ex.: período de teste).
  endsAt     DateTime? @map("ends_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module     Module    @relation(fields: [moduleCode], references: [code])

  @@id([tenantId, moduleCode])
  @@map("tenant_modules")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  /// Papel na nossa equipe; null para usuários de restaurante.
  staffRole    StaffRole? @map("staff_role")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships    Membership[]
  managedTenants AccountManagerTenant[]
  auditLogs      AuditLog[]

  @@map("users")
}

/// Vínculo de um usuário com um restaurante.
model Membership {
  userId    String     @map("user_id") @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  role      TenantRole
  createdAt DateTime   @default(now()) @map("created_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@map("memberships")
}

/// Carteira do gestor de conta: quais restaurantes ele atende.
model AccountManagerTenant {
  userId   String @map("user_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@map("account_manager_tenants")
}

/// Quem alterou o quê, quando e em qual restaurante.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// Fila de eventos entre módulos (ex.: pedido.entregue -> lançamento no financeiro).
model DomainEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([processedAt, createdAt])
  @@map("domain_events")
}

// =====================================================================
// Módulo Cardápio e pedidos (Sprint 1): cardápio, loja online, pedidos
// Valores em centavos (inteiros) para não ter erro de arredondamento.
// =====================================================================

enum OrderType {
  DELIVERY
  PICKUP
  /// Pedido do salão, lançado pelo garçom na mesa.
  DINE_IN
  /// Venda de balcão (PDV): o caixa lança e recebe na hora.
  COUNTER
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  IN_PREPARATION
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  CASH_ON_DELIVERY
  CARD_ON_DELIVERY
  /// Pago dentro do app de delivery (iFood, 99Food, Keeta); o app repassa depois.
  APP_ONLINE
}

/// Canal de venda: loja própria ou app de delivery.
enum SalesChannel {
  LOJA
  IFOOD
  FOOD99
  KEETA
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

/// Configuração da loja online do restaurante (1 por restaurante).
model Store {
  tenantId            String          @id @map("tenant_id") @db.Uuid
  /// Endereço público: /loja/<slug>
  slug                String          @unique
  displayName         String          @map("display_name")
  description         String?
  logoUrl             String?         @map("logo_url")
  /// Foto de capa no topo da loja online.
  coverUrl            String?         @map("cover_url")
  whatsapp            String?
  /// Cidade e UF (ex.: "Campinas - SP"), usada na rota do motoboy.
  city                String?
  isOpen              Boolean         @default(false) @map("is_open")
  acceptsDelivery     Boolean         @default(true) @map("accepts_delivery")
  acceptsPickup       Boolean         @default(true) @map("accepts_pickup")
  minOrderCents       Int             @default(0) @map("min_order_cents")
  /// Formas de pagamento aceitas (lista de PaymentMethod).
  paymentMethods      PaymentMethod[] @default([PIX, CASH_ON_DELIVERY, CARD_ON_DELIVERY]) @map("payment_methods")
  estimatedMinutes    Int             @default(40) @map("estimated_minutes")
  /// Taxa de serviço do salão sugerida no fechamento da mesa (pontos-base, 1000 = 10%; 0 = sem taxa).
  serviceFeeBps       Int             @default(1000) @map("service_fee_bps")
  /// Pedido agendado: o cliente escolhe dia e horário (vale também com a loja fechada agora).
  schedulingEnabled   Boolean         @default(false) @map("scheduling_enabled")
  /// Janela de horários para agendar, no horário de Brasília (ex.: 18:00 às 23:00; fechar antes de abrir = passa da meia-noite).
  scheduleOpensAt     String          @default("18:00") @map("schedule_opens_at")
  scheduleClosesAt    String          @default("23:00") @map("schedule_closes_at")
  /// Dias da semana com agendamento (0 = domingo). Vazio = todos.
  scheduleWeekdays    Int[]           @default([]) @map("schedule_weekdays")
  /// Antecedência mínima em minutos (ex.: 60 = só a partir de daqui a 1 hora).
  scheduleLeadMinutes Int             @default(60) @map("schedule_lead_minutes")
  /// Até quantos dias à frente o cliente pode agendar.
  scheduleMaxDays     Int             @default(7) @map("schedule_max_days")
  /// Intervalo entre os horários oferecidos (minutos).
  scheduleSlotMinutes Int             @default(30) @map("schedule_slot_minutes")
  /// Impressoras térmicas: largura do papel (58 ou 80 mm) do cupom do caixa e da comanda da cozinha.
  receiptWidthMm      Int             @default(80) @map("receipt_width_mm")
  kitchenWidthMm      Int             @default(80) @map("kitchen_width_mm")
  /// PDV: imprimir o cupom sozinho ao finalizar a venda, e quantas vias.
  receiptAutoPrint    Boolean         @default(true) @map("receipt_auto_print")
  receiptCopies       Int             @default(1) @map("receipt_copies")
  /// Mensagem no rodapé do cupom (ex.: "Obrigado! Volte sempre").
  receiptFooter       String?         @map("receipt_footer")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("stores")
}

/// Taxa de entrega por bairro.
model DeliveryZone {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  feeCents Int     @map("fee_cents")
  active   Boolean @default(true)
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("delivery_zones")
}

model MenuCategory {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  position  Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([tenantId, position])
  @@map("menu_categories")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  name            String
  description     String?
  priceCents      Int           @map("price_cents")
  imageUrl        String?       @map("image_url")
  position        Int           @default(0)
  /// Some da loja (ex.: fora do cardápio).
  active          Boolean       @default(true)
  /// Esgotado no momento: aparece, mas não pode ser pedido.
  available       Boolean       @default(true)
  /// Código PDV: o mesmo em todos os canais (loja, iFood, 99Food, Keeta) para reconhecer o item.
  pdvCode         String?       @map("pdv_code")
  /// Preço em cada app, em centavos ({ "IFOOD": 3290 }). Sem preço = mesmo da loja.
  channelPrices   Json          @default("{}") @map("channel_prices")
  /// Ficha técnica: [{ name, kind: INGREDIENT|PACKAGING|OTHER, costCents }] por unidade.
  costItems       Json          @default("[]") @map("cost_items")
  /// Outras despesas variáveis só deste produto (pontos-base, 100 = 1%).
  extraCostBps    Int           @default(0) @map("extra_cost_bps")
  /// Preço de/por: preço promocional e período (vazio = sem promoção; sem datas = vale até tirar).
  promoPriceCents Int?          @map("promo_price_cents")
  promoStartsAt   DateTime?     @map("promo_starts_at")
  promoEndsAt     DateTime?     @map("promo_ends_at")
  /// Combo: as etapas são os grupos de opções e cada opção pode apontar para um produto do cardápio.
  isCombo         Boolean       @default(false) @map("is_combo")
  /// Nota fiscal (NFC-e): NCM e CFOP do produto. Vazio = o padrão dos dados fiscais da loja.
  ncm             String?
  cfop            String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        MenuCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  optionGroups    OptionGroup[]
  /// Opções de combos que apontam para este produto.
  comboOptions    Option[]      @relation("ComboOptionProduct")

  @@unique([tenantId, pdvCode])
  @@index([tenantId, categoryId, position])
  @@map("products")
}

/// Grupo de adicionais de um produto (ex.: "Escolha a borda", mín. 1, máx. 1).
model OptionGroup {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  name      String
  minSelect Int      @default(0) @map("min_select")
  maxSelect Int      @default(1) @map("max_select")
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  options   Option[]

  @@map("option_groups")
}

model Option {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  groupId         String      @map("group_id") @db.Uuid
  name            String
  priceCents      Int         @default(0) @map("price_cents")
  /// Custo do adicional (ex.: bacon extra R$ 1,50), soma no CMV da venda.
  costCents       Int         @default(0) @map("cost_cents")
  /// Código PDV do adicional (pode repetir em produtos diferentes).
  pdvCode         String?     @map("pdv_code")
  available       Boolean     @default(true)
  position        Int         @default(0)
  /// No combo: o produto do cardápio que esta opção representa (segue a disponibilidade e o custo dele).
  linkedProductId String?     @map("linked_product_id") @db.Uuid
  linkedProduct   Product?    @relation("ComboOptionProduct", fields: [linkedProductId], references: [id], onDelete: Cascade)
  group           OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([linkedProductId])
  @@map("options")
}

/// Cliente final que pediu pela loja online (por restaurante, identificado pelo telefone).
model Customer {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  name              String
  /// Só dígitos, com DDD (ex.: 11987654321).
  phone             String
  /// CPF ou CNPJ, só dígitos (o Asaas exige para gerar o Pix).
  document          String?
  /// Id do cliente na conta Asaas do restaurante (para não cadastrar de novo).
  gatewayCustomerId String?              @map("gateway_customer_id")
  /// Indique e Ganhe: código do link de indicação deste cliente (ex.: ANA7K2). Criado no primeiro pedido.
  referralCode      String?              @map("referral_code")
  /// Quem indicou este cliente (só vale no primeiro pedido).
  referredById      String?              @map("referred_by_id") @db.Uuid
  referredBy        Customer?            @relation("Referral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         Customer[]           @relation("Referral")
  createdAt         DateTime             @default(now()) @map("created_at")
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders            Order[]
  loyaltyMoves      LoyaltyTransaction[]

  @@unique([tenantId, phone])
  @@unique([tenantId, referralCode])
  @@map("customers")
}

model Order {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  /// Número curto por restaurante, para falar com o cliente e imprimir.
  number                Int
  /// Código secreto da página de acompanhamento (/pedido/<trackingCode>).
  trackingCode          String               @unique @map("tracking_code")
  customerId            String               @map("customer_id") @db.Uuid
  type                  OrderType
  status                OrderStatus
  customerName          String               @map("customer_name")
  customerPhone         String               @map("customer_phone")
  addressStreet         String?              @map("address_street")
  addressNumber         String?              @map("address_number")
  addressComplement     String?              @map("address_complement")
  addressReference      String?              @map("address_reference")
  deliveryZoneId        String?              @map("delivery_zone_id") @db.Uuid
  deliveryZoneName      String?              @map("delivery_zone_name")
  notes                 String?
  subtotalCents         Int                  @map("subtotal_cents")
  deliveryFeeCents      Int                  @map("delivery_fee_cents")
  discountCents         Int                  @default(0) @map("discount_cents")
  /// Cupom usado (loja própria). O desconto do cupom fica em discountCents.
  couponId              String?              @map("coupon_id") @db.Uuid
  couponCode            String?              @map("coupon_code")
  /// Quem pagou o desconto do cupom (congelado no pedido). RESTAURANT no cupom da loja; na campanha da rede, conforme a divisão.
  couponFundedBy        CouponFunding?       @map("coupon_funded_by")
  coupon                Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  /// Cupom de campanha da rede (o código fica em couponCode e o desconto inteiro em discountCents).
  campaignId            String?              @map("campaign_id") @db.Uuid
  campaign              Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /// Parte de discountCents bancada pela Delivery360 (campanha mista ou 100% nossa).
  couponPlatformCents   Int                  @default(0) @map("coupon_platform_cents")
  /// Impulso Delivery360: desconto automático bancado pela Delivery360 (soma com o cupom do restaurante).
  platformDiscountCents Int                  @default(0) @map("platform_discount_cents")
  platformCouponId      String?              @map("platform_coupon_id") @db.Uuid
  platformCoupon        Coupon?              @relation("PlatformBoost", fields: [platformCouponId], references: [id], onDelete: SetNull)
  /// Quanto o cliente economizou com preço de/por (já fora do subtotal). Vai para "Descontos e cupons" no DRE.
  promoDiscountCents    Int                  @default(0) @map("promo_discount_cents")
  /// Fidelidade (bancado pelo restaurante): soma do prêmio trocado por pontos, do desconto do clube e da indicação.
  loyaltyDiscountCents  Int                  @default(0) @map("loyalty_discount_cents")
  /// Prêmio trocado por pontos neste pedido (nome congelado) e quantos pontos saíram.
  rewardId              String?              @map("reward_id") @db.Uuid
  rewardName            String?              @map("reward_name")
  rewardDiscountCents   Int                  @default(0) @map("reward_discount_cents")
  pointsSpent           Int                  @default(0) @map("points_spent")
  /// Clube de benefícios: nível do cliente no pedido e o desconto que ele deu.
  clubLevelName         String?              @map("club_level_name")
  clubDiscountCents     Int                  @default(0) @map("club_discount_cents")
  /// Indique e Ganhe: desconto do primeiro pedido de quem chegou por indicação.
  referralDiscountCents Int                  @default(0) @map("referral_discount_cents")
  totalCents            Int                  @map("total_cents")
  paymentMethod         PaymentMethod        @map("payment_method")
  /// De onde veio o pedido (loja própria ou app de delivery).
  channel               SalesChannel         @default(LOJA)
  /// Id do pedido no app de delivery (evita importar duas vezes).
  externalId            String?              @map("external_id")
  /// Número do pedido mostrado pelo app (ex.: "#4821" no iFood).
  externalCode          String?              @map("external_code")
  /// Código de entrega informado pelo app (no lugar dos 4 últimos dígitos do telefone).
  deliveryCode          String?              @map("delivery_code")
  /// Pedido agendado: dia e hora em que o cliente quer receber (ou retirar). Vazio = o quanto antes.
  /// Fica em "Agendados" no painel e só entra na cozinha perto da hora (horário − tempo de preparo).
  scheduledFor          DateTime?            @map("scheduled_for")
  /// Troco para quanto (dinheiro na entrega).
  changeForCents        Int?                 @map("change_for_cents")
  utmSource             String?              @map("utm_source")
  utmCampaign           String?              @map("utm_campaign")
  /// Primeira impressão do pedido (evita imprimir de novo em outra tela).
  printedAt             DateTime?            @map("printed_at")
  /// Lote de entrega (motoboy) em que o pedido saiu.
  batchId               String?              @map("batch_id") @db.Uuid
  batch                 DeliveryBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  deliveredAt           DateTime?            @map("delivered_at")
  /// Tentativas erradas do código de 4 dígitos (trava em 5).
  deliveryCodeFails     Int                  @default(0) @map("delivery_code_fails")
  /// Última ocorrência ainda não resolvida (o motoboy não conseguiu entregar). Some quando o pedido sai de novo.
  deliveryIssue         DeliveryFailReason?  @map("delivery_issue")
  deliveryIssueAt       DateTime?            @map("delivery_issue_at")
  /// Salão: a conta da mesa em que o pedido foi lançado, o nome da mesa e quem lançou.
  tabId                 String?              @map("tab_id") @db.Uuid
  tab                   TableTab?            @relation(fields: [tabId], references: [id], onDelete: SetNull)
  tableName             String?              @map("table_name")
  waiterName            String?              @map("waiter_name")
  /// Avaliação do cliente depois de receber (1 a 5 estrelas; 5 = excelente). Uma vez só.
  ratingStore           Int?                 @map("rating_store")
  ratingDelivery        Int?                 @map("rating_delivery")
  ratingComment         String?              @map("rating_comment")
  ratedAt               DateTime?            @map("rated_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer              Customer             @relation(fields: [customerId], references: [id])
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  payments              Payment[]
  channelLink           ChannelOrderLink?
  deliveryAttempts      DeliveryAttempt[]
  tip                   Tip?
  /// PDV: CPF ou CNPJ na nota (só números).
  customerDocument      String?              @map("customer_document")
  counterPayments       CounterPayment[]
  fiscalDocuments       FiscalDocument[]
  /// Totem de autoatendimento: de qual totem veio (vazio = não veio do totem), comer aqui ou levar,
  /// a senha de chamada e como o cliente disse que ia pagar no caixa (só aviso).
  totemId               String?              @map("totem_id") @db.Uuid
  totem                 Totem?               @relation(fields: [totemId], references: [id], onDelete: SetNull)
  consumption           TotemConsumption?
  ticket                String?
  payHint               String?              @map("pay_hint")
  /// Chave que a tela manda ao criar o pedido: se a internet piscar e ela mandar de novo, não duplica.
  requestKey            String?              @map("request_key")

  @@unique([tenantId, number])
  @@unique([tenantId, requestKey])
  @@index([tenantId, totemId, status])
  @@unique([tenantId, channel, externalId])
  @@index([tenantId, status, createdAt])
  @@index([batchId])
  @@index([couponId])
  @@index([platformCouponId])
  @@index([campaignId])
  @@index([tabId])
  @@map("orders")
}

// =====================================================================
// Salão: mesas e conta da mesa (o garçom lança, a cozinha recebe, o caixa fecha)
// =====================================================================

enum TabStatus {
  OPEN
  CLOSED
}

/// Mesa do salão (ou balcão, varanda...). Só o nome importa; a ordem é a da tela do garçom.
model DiningTable {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  name      String
  position  Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tabs      TableTab[]

  @@unique([tenantId, name])
  @@index([tenantId, position])
  @@map("dining_tables")
}

/// Conta da mesa: abre no primeiro pedido do garçom e soma cada rodada até o fechamento.
/// Cada rodada é um pedido (Order DINE_IN) que vai para a cozinha; a venda entra no financeiro no fechamento.
model TableTab {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  tableId         String         @map("table_id") @db.Uuid
  /// Nome da mesa congelado (a mesa pode ser renomeada depois).
  tableName       String         @map("table_name")
  /// Igual ao tableId enquanto a conta está aberta: garante uma conta aberta por mesa.
  openKey         String?        @unique @map("open_key") @db.Uuid
  status          TabStatus      @default(OPEN)
  people          Int?
  openedById      String?        @map("opened_by_id") @db.Uuid
  /// Garçom responsável pela mesa: quem abriu, ou quem "assumiu" depois. Recebe os avisos de prato pronto.
  waiterId        String?        @map("waiter_id") @db.Uuid
  waiterName      String?        @map("waiter_name")
  openedAt        DateTime       @default(now()) @map("opened_at")
  closedById      String?        @map("closed_by_id") @db.Uuid
  closedAt        DateTime?      @map("closed_at")
  /// Forma de pagamento de maior valor (a conta pode ter sido paga com várias).
  paymentMethod   PaymentMethod? @map("payment_method")
  /// Cobrar a taxa de serviço da loja nesta conta (o cliente pode recusar).
  serviceFee      Boolean        @default(true) @map("service_fee")
  /// No fechamento: soma dos pedidos, taxa de serviço e total pago.
  subtotalCents   Int            @default(0) @map("subtotal_cents")
  serviceFeeCents Int            @default(0) @map("service_fee_cents")
  totalCents      Int            @default(0) @map("total_cents")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table           DiningTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orders          Order[]
  payments        TabPayment[]

  @@index([tenantId, status])
  @@index([tableId])
  @@index([waiterId])
  @@map("table_tabs")
}

/// Pagamento (parcial ou total) da conta da mesa: cada cartão, Pix ou dinheiro é uma linha.
/// A mesa só fecha quando os pagamentos somam o total; o financeiro lança cada um com a sua forma.
model TabPayment {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tabId       String        @map("tab_id") @db.Uuid
  method      PaymentMethod
  amountCents Int           @map("amount_cents")
  /// Quem pagou, se o garçom anotou (ex.: "João").
  label       String?
  userId      String?       @map("user_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  tab         TableTab      @relation(fields: [tabId], references: [id], onDelete: Cascade)

  @@index([tabId])
  @@map("tab_payments")
}

/// Item do pedido com nome e preço copiados no momento da compra (o cardápio pode mudar depois).
model OrderItem {
  id                 String            @id @default(uuid()) @db.Uuid
  orderId            String            @map("order_id") @db.Uuid
  productId          String?           @map("product_id") @db.Uuid
  name               String
  unitPriceCents     Int               @map("unit_price_cents")
  quantity           Int
  notes              String?
  totalCents         Int               @map("total_cents")
  /// Custo unitário pela ficha técnica no momento da venda (CMV teórico).
  unitCostCents      Int               @default(0) @map("unit_cost_cents")
  /// Preço unitário sem a promoção (igual ao unitPriceCents quando não havia promoção).
  listUnitPriceCents Int?              @map("list_unit_price_cents")
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  options            OrderItemOption[]

  @@map("order_items")
}

model OrderItemOption {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  optionId    String?   @map("option_id") @db.Uuid
  groupName   String    @map("group_name")
  name        String
  priceCents  Int       @map("price_cents")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_item_options")
}

model OrderStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @map("order_id") @db.Uuid
  status     OrderStatus
  /// null = sistema (ex.: webhook do pagamento).
  userId     String?     @map("user_id") @db.Uuid
  note       String?
  createdAt  DateTime    @default(now()) @map("created_at")
  /// Quando o aviso deste status saiu (ou foi descartado) no WhatsApp do cliente.
  notifiedAt DateTime?   @map("notified_at")
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([notifiedAt, createdAt])
  @@map("order_status_history")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  /// "fake" (desenvolvimento), "offline" (pagar na entrega) ou o gateway real.
  provider     String
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  amountCents  Int           @map("amount_cents")
  feeCents     Int           @default(0) @map("fee_cents")
  /// Id do pagamento no gateway.
  externalId   String?       @map("external_id")
  /// PIX copia e cola (quando houver).
  pixCopyPaste String?       @map("pix_copy_paste")
  /// QR Code do Pix em PNG (base64), quando o gateway manda a imagem.
  pixQrImage   String?       @map("pix_qr_image")
  /// Cartão: página segura do gateway onde o cliente paga.
  checkoutUrl  String?       @map("checkout_url")
  expiresAt    DateTime?     @map("expires_at")
  paidAt       DateTime?     @map("paid_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@map("payments")
}

/// Conta do gateway de pagamento do restaurante (Asaas): o Pix cai direto nela.
/// A chave da API fica cifrada e nunca volta para o navegador.
model PaymentAccount {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  provider        String   @default("asaas")
  sandbox         Boolean  @default(false)
  apiKeyEncrypted String   @map("api_key_encrypted")
  apiKeyLast4     String   @map("api_key_last4")
  accountName     String?  @map("account_name")
  /// Token que o Asaas manda no header asaas-access-token de cada webhook.
  webhookToken    String   @map("webhook_token")
  webhookId       String?  @map("webhook_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payment_accounts")
}

/// WhatsApp do próprio restaurante, conectado por QR Code (instância no servidor de WhatsApp).
model WhatsappAccount {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @unique @map("tenant_id") @db.Uuid
  instanceName  String    @unique @map("instance_name")
  /// PENDING (esperando ler o QR), CONNECTED, DISCONNECTED.
  status        String    @default("PENDING")
  phone         String?
  /// Mandar o status do pedido para o cliente.
  notifyEnabled Boolean   @default(true) @map("notify_enabled")
  connectedAt   DateTime? @map("connected_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_accounts")
}

// ---------- Entregas ----------

enum BatchStatus {
  OUT
  DONE
  CANCELLED
}

/// Motoboy cadastrado pelo restaurante. Entra na tela do entregador por um link secreto.
model Courier {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  name           String
  phone          String
  /// Quanto o restaurante paga por entrega (vai para a Gestão como custo).
  feeCents       Int               @default(0) @map("fee_cents")
  active         Boolean           @default(true)
  /// Token do link /entregador/<token>; trocar o token derruba o link antigo.
  accessToken    String            @unique @map("access_token")
  /// Última posição enviada pelo celular do motoboy (só durante entregas).
  lastLat        Float?            @map("last_lat")
  lastLng        Float?            @map("last_lng")
  lastAccuracy   Float?            @map("last_accuracy")
  lastLocationAt DateTime?         @map("last_location_at")
  /// Placa da moto (aparece no registro de cada entrega).
  plate          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches        DeliveryBatch[]
  attempts       DeliveryAttempt[]
  tips           Tip[]

  @@index([tenantId])
  @@map("couriers")
}

/// Lote: pedidos que saem juntos com um motoboy.
model DeliveryBatch {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  number     Int
  courierId  String      @map("courier_id") @db.Uuid
  status     BatchStatus @default(OUT)
  createdBy  String?     @map("created_by") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")
  finishedAt DateTime?   @map("finished_at")
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courier    Courier     @relation(fields: [courierId], references: [id])
  orders     Order[]

  @@unique([tenantId, number])
  @@index([courierId, status])
  @@map("delivery_batches")
}

enum DeliveryOutcome {
  DELIVERED
  FAILED
}

enum DeliveryFailReason {
  /// Endereço não localizado.
  ADDRESS_NOT_FOUND
  /// Cliente não atende / ninguém no local (ex.: dormindo).
  CUSTOMER_ABSENT
  /// Cliente recusou ou não quer mais o pedido.
  CUSTOMER_REFUSED
  OTHER
}

/// Registro de cada tentativa de entrega (entregue ou ocorrência). O motoboy não altera depois;
/// só o restaurante corrige (com auditoria). Guarda cópia do nome e da placa do motoboy no momento.
model DeliveryAttempt {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  orderId      String              @map("order_id") @db.Uuid
  courierId    String              @map("courier_id") @db.Uuid
  batchId      String?             @map("batch_id") @db.Uuid
  batchNumber  Int?                @map("batch_number")
  outcome      DeliveryOutcome
  failReason   DeliveryFailReason? @map("fail_reason")
  note         String?
  receiverName String?             @map("receiver_name")
  /// Código de 4 dígitos conferido na entrega.
  code         String?
  courierName  String              @map("courier_name")
  courierPlate String?             @map("courier_plate")
  /// Onde o celular do motoboy estava (se tinha sinal recente).
  lat          Float?
  lng          Float?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier      Courier             @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([courierId, createdAt])
  @@index([tenantId, createdAt])
  @@map("delivery_attempts")
}

/// Gorjeta do cliente para o motoboy. Entra no caixa do restaurante, que repassa ao motoboy como prêmio.
/// Não é receita do restaurante: na Gestão entra como valor a repassar.
model Tip {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  orderId      String        @unique @map("order_id") @db.Uuid
  courierId    String        @map("courier_id") @db.Uuid
  amountCents  Int           @map("amount_cents")
  provider     String
  status       PaymentStatus @default(PENDING)
  externalId   String?       @map("external_id")
  pixCopyPaste String?       @map("pix_copy_paste")
  /// QR Code do Pix em PNG (base64), quando o gateway manda a imagem.
  pixQrImage   String?       @map("pix_qr_image")
  expiresAt    DateTime?     @map("expires_at")
  paidAt       DateTime?     @map("paid_at")
  /// Quando o restaurante entregou o dinheiro ao motoboy.
  paidOutAt    DateTime?     @map("paid_out_at")
  paidOutBy    String?       @map("paid_out_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier      Courier       @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([tenantId, status, paidOutAt])
  @@index([courierId])
  @@map("tips")
}

// ---------- Módulo Gestão: financeiro ----------

enum AccountKind {
  /// Receita bruta (grupo 1)
  REVENUE
  /// Deduções da receita (grupo 2)
  DEDUCTION
  /// CMV e despesas operacionais (grupos 3 a 8)
  EXPENSE
  /// Resultado financeiro (grupo 9): juros, tarifas, rendimentos
  FINANCIAL
  /// Fora da DRE (grupos 10 e 11): investimentos, retiradas, valores de terceiros
  OFF_DRE
}

/// Plano de contas do restaurante (vem pronto e pode ganhar contas novas).
model Account {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  /// "6.1"
  code      String
  group     Int
  name      String
  kind      AccountKind
  /// Conta padrão do sistema (lançamentos automáticos usam). Pode ser renomeada, não excluída.
  system    Boolean          @default(false)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries   FinancialEntry[]

  @@unique([tenantId, code])
  @@map("accounts")
}

enum EntryType {
  RECEIVABLE
  PAYABLE
}

enum EntryStatus {
  OPEN
  PAID
  CANCELLED
}

/// Conta a pagar ou a receber. A DRE usa a data de competência; o caixa usa a data do pagamento.
model FinancialEntry {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  type           EntryType
  accountId      String        @map("account_id") @db.Uuid
  description    String
  counterparty   String?
  amountCents    Int           @map("amount_cents")
  competenceDate DateTime      @map("competence_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  status         EntryStatus   @default(OPEN)
  paidAt         DateTime?     @map("paid_at") @db.Date
  notes          String?
  /// Forma de pagamento informada pelo cliente (vendas).
  paymentMethod  String?       @map("payment_method")
  /// Canal de venda do pedido que gerou o lançamento (loja, iFood, 99Food, Keeta).
  channel        SalesChannel?
  /// "manual" ou o módulo que gerou (cardapio, entregas...).
  source         String        @default("manual")
  /// Chave do lançamento automático (evita duplicar se o evento for processado de novo).
  externalKey    String?       @map("external_key")
  /// Só de resultado (DRE), sem dinheiro: preço cheio e desconto de promoção/cupom.
  /// Não aparece em contas a pagar/receber nem no caixa, para o financeiro bater com o que entrou de fato.
  memo           Boolean       @default(false)
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account        Account       @relation(fields: [accountId], references: [id])

  @@unique([tenantId, externalKey])
  @@index([tenantId, type, status, dueDate])
  @@index([tenantId, competenceDate])
  @@map("financial_entries")
}

/// Impostos e taxas do restaurante (pontos-base, 100 = 1%). Usados na ficha técnica e nos lançamentos das vendas.
model FinanceSettings {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  salesTaxBps          Int      @default(0) @map("sales_tax_bps")
  pixFeeBps            Int      @default(0) @map("pix_fee_bps")
  creditFeeBps         Int      @default(0) @map("credit_fee_bps")
  cardOnDeliveryFeeBps Int      @default(0) @map("card_on_delivery_fee_bps")
  targetMarginBps      Int      @default(2000) @map("target_margin_bps")
  /// Dia do mês em que o imposto vence (mês seguinte à venda).
  taxDueDay            Int      @default(20) @map("tax_due_day")
  /// Encargos sobre a folha CLT pagos pelo restaurante: FGTS (8%) e INSS patronal (0% no Simples, anexos I a III).
  fgtsBps              Int      @default(800) @map("fgts_bps")
  employerInssBps      Int      @default(0) @map("employer_inss_bps")
  /// Dia do pagamento do salário no mês seguinte (ex.: 5).
  payDay               Int      @default(5) @map("pay_day")
  updatedAt            DateTime @updatedAt @map("updated_at")
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("finance_settings")
}

/// Configuração de cada app de delivery do restaurante (comissão, taxa e prazo de repasse).
model ChannelSetting {
  tenantId      String       @map("tenant_id") @db.Uuid
  channel       SalesChannel
  active        Boolean      @default(false)
  /// Código da loja no app (merchant id).
  merchantId    String?      @map("merchant_id")
  commissionBps Int          @default(0) @map("commission_bps")
  paymentFeeBps Int          @default(0) @map("payment_fee_bps")
  payoutDays    Int          @default(30) @map("payout_days")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, channel])
  @@map("channel_settings")
}

/// Hub dos apps: qual restaurante é dono de cada código de loja (merchant id). Um código, um restaurante só.
model ChannelMerchant {
  channel    SalesChannel
  merchantId String       @map("merchant_id")
  tenantId   String       @map("tenant_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at")
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([channel, merchantId])
  @@unique([tenantId, channel])
  @@map("channel_merchants")
}

enum ChannelEventStatus {
  RECEIVED
  PROCESSED
  /// Não é para nós (restaurante desconhecido, evento sem efeito).
  IGNORED
  /// Deu erro: pode ser reprocessado pelo dono.
  FAILED
}

/// Evento recebido de um app (webhook), guardado como chegou. O mesmo evento (canal + id) entra uma vez só.
model ChannelEvent {
  id              String             @id @default(uuid()) @db.Uuid
  /// null quando o código da loja não é de nenhum restaurante.
  tenantId        String?            @map("tenant_id") @db.Uuid
  channel         SalesChannel
  eventId         String             @map("event_id")
  /// Código do evento no app (ex.: PLACED, CONFIRMED, CANCELLED).
  type            String
  merchantId      String?            @map("merchant_id")
  orderExternalId String?            @map("order_external_id")
  payload         Json
  status          ChannelEventStatus @default(RECEIVED)
  attempts        Int                @default(0)
  error           String?
  processedAt     DateTime?          @map("processed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  tenant          Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([channel, eventId])
  @@index([tenantId, channel, orderExternalId])
  @@map("channel_events")
}

/// Vínculo pedido do app ↔ pedido interno, com a situação no app (separada do nosso status) e os valores que o app informou.
model ChannelOrderLink {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  channel         SalesChannel
  externalId      String       @map("external_id")
  /// null enquanto o pedido ainda não entrou (ex.: cancelado antes de chegar).
  orderId         String?      @unique @map("order_id") @db.Uuid
  /// Situação no app (PLACED, CONFIRMED, DISPATCHED, CONCLUDED, CANCELLED...).
  externalStatus  String       @map("external_status")
  /// Valores informados pelo app, em centavos: itens, entrega, descontos (app/loja), comissão, taxa, repasse previsto.
  externalAmounts Json?        @map("external_amounts")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([tenantId, channel, externalId])
  @@map("channel_order_links")
}

// ---------- Gestão de pessoas ----------

/// Tipo de contratação (folha gerencial: não substitui o eSocial do contador).
enum EmploymentType {
  CLT
  PJ
  /// Diarista / freelancer: recebe por dia trabalhado.
  DIARISTA
  ESTAGIO
}

/// Funcionário do restaurante.
model Employee {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  name            String
  /// Cargo (ex.: cozinheiro, atendente, pizzaiolo).
  role            String
  type            EmploymentType
  phone           String?
  document        String?
  pixKey          String?        @map("pix_key")
  /// Salário mensal (CLT, PJ, estágio).
  salaryCents     Int            @default(0) @map("salary_cents")
  /// Valor da diária (diarista).
  dailyRateCents  Int            @default(0) @map("daily_rate_cents")
  /// Vale-transporte e vale-alimentação por mês (custo do restaurante).
  transportCents  Int            @default(0) @map("transport_cents")
  mealCents       Int            @default(0) @map("meal_cents")
  /// Folga fixa da semana: 0 = domingo ... 6 = sábado (null = sem folga fixa).
  weeklyDayOff    Int?           @map("weekly_day_off")
  admissionDate   DateTime       @map("admission_date") @db.Date
  terminationDate DateTime?      @map("termination_date") @db.Date
  active          Boolean        @default(true)
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  absences        Absence[]
  payrollItems    PayrollItem[]

  @@index([tenantId, active])
  @@map("employees")
}

enum AbsenceKind {
  /// Folga extra (além da folga fixa).
  FOLGA
  FERIAS
  ATESTADO
  /// Falta sem justificativa: desconta do salário.
  FALTA
}

/// Folga, férias, atestado ou falta, em um período (dias inteiros).
model Absence {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  employeeId String      @map("employee_id") @db.Uuid
  kind       AbsenceKind
  startDate  DateTime    @map("start_date") @db.Date
  endDate    DateTime    @map("end_date") @db.Date
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, startDate])
  @@map("absences")
}

enum PayrollStatus {
  DRAFT
  CLOSED
}

/// Folha gerencial do mês. Fechar gera as contas a pagar (grupo 4) e entra na DRE.
model Payroll {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  /// "2026-11"
  month     String
  status    PayrollStatus @default(DRAFT)
  closedAt  DateTime?     @map("closed_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     PayrollItem[]

  @@unique([tenantId, month])
  @@map("payrolls")
}

/// Linha da folha por funcionário (valores em centavos).
model PayrollItem {
  id             String   @id @default(uuid()) @db.Uuid
  payrollId      String   @map("payroll_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  /// Salário do mês (proporcional se entrou ou saiu no meio) ou diárias.
  baseCents      Int      @map("base_cents")
  /// Dias trabalhados (diarista) ou dias de salário no mês.
  days           Int
  /// Horas extras, adicional noturno, comissão.
  extrasCents    Int      @default(0) @map("extras_cents")
  /// Prêmio / bonificação.
  bonusCents     Int      @default(0) @map("bonus_cents")
  /// Faltas descontadas (automático).
  absenceCents   Int      @default(0) @map("absence_cents")
  absenceDays    Int      @default(0) @map("absence_days")
  /// Adiantamentos e outros descontos.
  advanceCents   Int      @default(0) @map("advance_cents")
  /// Vale-transporte + vale-alimentação.
  benefitsCents  Int      @default(0) @map("benefits_cents")
  /// Encargos do restaurante (FGTS e INSS patronal, conforme configuração).
  chargesCents   Int      @default(0) @map("charges_cents")
  /// Provisão de férias + 1/3 e 13º (reserva mensal).
  provisionCents Int      @default(0) @map("provision_cents")
  /// A pagar ao funcionário.
  netCents       Int      @map("net_cents")
  notes          String?
  payroll        Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollId, employeeId])
  @@map("payroll_items")
}

enum CouponFunding {
  RESTAURANT
  PLATFORM
  MIXED
}

/// Campanha da rede, criada pela equipe Delivery360: banner nas lojas participantes e, se tiver código,
/// um cupom que o cliente usa em qualquer uma delas. O custo do desconto se divide entre a Delivery360 e o restaurante.
model Campaign {
  id                 String     @id @default(uuid()) @db.Uuid
  title              String
  subtitle           String?
  imageUrl           String     @map("image_url")
  /// Lojas da campanha. Vazio = todas.
  tenantIds          String[]   @default([]) @map("tenant_ids")
  /// Lojas que saíram (só pode sair quando o restaurante banca parte do cupom).
  optedOutTenantIds  String[]   @default([]) @map("opted_out_tenant_ids")
  startsAt           DateTime?  @map("starts_at")
  endsAt             DateTime?  @map("ends_at")
  active             Boolean    @default(true)
  position           Int        @default(0)
  /// A arte já traz o texto: a loja mostra a imagem inteira, sem escrever título por cima.
  fullArt            Boolean    @default(false) @map("full_art")
  /// Código do cupom da campanha. Sem código = só banner.
  couponCode         String?    @unique @map("coupon_code")
  type               CouponType @default(PERCENT)
  /// PERCENT: pontos-base (1000 = 10%). FIXED: centavos. FREE_DELIVERY: 0.
  value              Int        @default(0)
  maxDiscountCents   Int?       @map("max_discount_cents")
  minOrderCents      Int        @default(0) @map("min_order_cents")
  weekdays           Int[]      @default([])
  /// Limite de usos somando todas as lojas.
  maxUses            Int?       @map("max_uses")
  maxUsesPerCustomer Int?       @default(1) @map("max_uses_per_customer")
  firstOrderOnly     Boolean    @default(false) @map("first_order_only")
  combinesWithPromo  Boolean    @default(false) @map("combines_with_promo")
  /// Parte do desconto bancada pela Delivery360, em pontos-base (10000 = 100% nossa; 0 = 100% do restaurante).
  platformShareBps   Int        @default(10000) @map("platform_share_bps")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  orders             Order[]

  @@map("campaigns")
}

enum CouponType {
  /// Percentual sobre os produtos.
  PERCENT
  /// Valor fixo em reais.
  FIXED
  /// Entrega grátis (desconta a taxa do bairro).
  FREE_DELIVERY
}

/// Cupom de desconto da loja própria.
model Coupon {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  /// Sempre em maiúsculas, sem espaços (ex.: VOLTEI15).
  code               String
  description        String?
  type               CouponType
  /// PERCENT: pontos-base (1000 = 10%). FIXED: centavos. FREE_DELIVERY: 0.
  value              Int           @default(0)
  /// Teto do desconto (só no percentual).
  maxDiscountCents   Int?          @map("max_discount_cents")
  minOrderCents      Int           @default(0) @map("min_order_cents")
  startsAt           DateTime?     @map("starts_at")
  endsAt             DateTime?     @map("ends_at")
  /// Dias da semana em que vale (0 = domingo). Vazio = todos.
  weekdays           Int[]         @default([])
  maxUses            Int?          @map("max_uses")
  maxUsesPerCustomer Int?          @default(1) @map("max_uses_per_customer")
  firstOrderOnly     Boolean       @default(false) @map("first_order_only")
  /// Vale também sobre produtos em preço de/por.
  combinesWithPromo  Boolean       @default(false) @map("combines_with_promo")
  /// Só vale para estes produtos ou combos (vazio = pedido inteiro).
  productIds         String[]      @default([]) @map("product_ids")
  /// Quem paga o desconto. PLATFORM = impulso Delivery360: criado pela nossa equipe, entra sozinho
  /// (sem código) nos pedidos que se encaixam e soma com o cupom do restaurante. O restaurante
  /// recebe o valor da Delivery360 e não pode alterar o impulso.
  fundedBy           CouponFunding @default(RESTAURANT) @map("funded_by")
  /// Aparece na faixa de cupons da loja (falso = só quem tem o código).
  public             Boolean       @default(false)
  active             Boolean       @default(true)
  createdAt          DateTime      @default(now()) @map("created_at")
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders             Order[]
  boostedOrders      Order[]       @relation("PlatformBoost")

  @@unique([tenantId, code])
  @@map("coupons")
}

/// Foto enviada pelo painel (produto, logo, capa, banner). Fica no banco para não sumir em hospedagem
/// sem disco fixo; a loja busca por /public/uploads/:id, com cache longo (o conteúdo nunca muda).
// =====================================================================
// Fidelidade: pontos por pedido, prêmios, clube de benefícios e Indique e Ganhe
// =====================================================================

/// Regras do programa de fidelidade da loja (1 por restaurante). Tudo é bancado pelo restaurante.
model LoyaltyProgram {
  tenantId               String   @id @map("tenant_id") @db.Uuid
  /// Pontos por pedido: o cliente ganha pontos quando o pedido é entregue ou retirado.
  enabled                Boolean  @default(false)
  /// Pontos a cada R$ 1,00 pago nos produtos (a taxa de entrega não conta).
  pointsPerReal          Int      @default(1) @map("points_per_real")
  /// Pontos vencem depois de N dias sem pedir (0 = não vencem).
  expireDays             Int      @default(0) @map("expire_days")
  /// Clube de benefícios: níveis com desconto automático.
  clubEnabled            Boolean  @default(false) @map("club_enabled")
  /// Indique e Ganhe.
  referralEnabled        Boolean  @default(false) @map("referral_enabled")
  /// Desconto do amigo indicado no primeiro pedido (centavos).
  referralFriendCents    Int      @default(1000) @map("referral_friend_cents")
  /// Pedido mínimo do amigo para ganhar o desconto (centavos).
  referralMinOrderCents  Int      @default(3000) @map("referral_min_order_cents")
  /// Pontos de quem indicou, quando o primeiro pedido do amigo é entregue.
  referralReferrerPoints Int      @default(100) @map("referral_referrer_points")
  updatedAt              DateTime @updatedAt @map("updated_at")
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("loyalty_programs")
}

enum RewardType {
  /// Desconto em reais.
  FIXED
  /// Entrega grátis.
  FREE_DELIVERY
  /// Um produto do cardápio de graça (o cliente coloca no carrinho).
  PRODUCT
}

/// Prêmio que o cliente troca por pontos no carrinho.
model LoyaltyReward {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  name          String
  pointsCost    Int        @map("points_cost")
  type          RewardType
  /// FIXED: centavos de desconto.
  valueCents    Int        @default(0) @map("value_cents")
  /// PRODUCT: o produto que sai de graça (uma unidade, sem os adicionais).
  productId     String?    @map("product_id") @db.Uuid
  minOrderCents Int        @default(0) @map("min_order_cents")
  active        Boolean    @default(true)
  position      Int        @default(0)
  createdAt     DateTime   @default(now()) @map("created_at")
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, position])
  @@map("loyalty_rewards")
}

/// Nível do clube de benefícios (ex.: Prata a partir de 300 pontos ganhos em 12 meses: 5% em todo pedido).
model ClubLevel {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  /// Pontos ganhos nos últimos 12 meses para entrar no nível.
  minPoints    Int      @map("min_points")
  /// Desconto automático nos produtos (pontos-base, 500 = 5%).
  discountBps  Int      @default(0) @map("discount_bps")
  freeDelivery Boolean  @default(false) @map("free_delivery")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("club_levels")
}

enum LoyaltyKind {
  /// Ganhou com um pedido entregue.
  EARN
  /// Trocou por um prêmio.
  REDEEM
  /// Devolvidos (pedido com prêmio cancelado).
  REFUND
  /// Ganhou porque um amigo indicado fez o primeiro pedido.
  REFERRAL
  /// Ajuste manual do restaurante.
  ADJUST
  /// Venceram por falta de pedido.
  EXPIRE
}

/// Extrato de pontos do cliente. O saldo é a soma.
model LoyaltyTransaction {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  points     Int
  kind       LoyaltyKind
  /// Pedido que gerou o movimento (uma vez só por pedido e tipo).
  orderId    String?     @map("order_id") @db.Uuid
  note       String?
  createdAt  DateTime    @default(now()) @map("created_at")
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
  @@index([tenantId, customerId, createdAt])
  @@map("loyalty_transactions")
}

model Upload {
  id          String   @id @default(uuid()) @db.Uuid
  /// Restaurante dono da foto; vazio = equipe Delivery360 (banners de campanha).
  tenantId    String?  @map("tenant_id") @db.Uuid
  mime        String
  bytes       Bytes
  size        Int
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("uploads")
}

// =====================================================================
// PDV (venda de balcão) e caixa
// =====================================================================

enum CashSessionStatus {
  OPEN
  CLOSED
}

/// Turno do caixa: abre com o fundo de troco e fecha com a contagem da gaveta.
/// O esperado em dinheiro = fundo + vendas em dinheiro (PDV e salão) + suprimentos − sangrias.
/// Comer aqui ou levar (totem de autoatendimento).
enum TotemConsumption {
  EAT_IN
  TAKEAWAY
}

/// Totem de autoatendimento do restaurante. Endereço: /totem/<slug>?t=<id>.
model Totem {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  /// Modos oferecidos na tela (nenhum ligado = os dois).
  eatIn     Boolean  @default(true) @map("eat_in")
  takeaway  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([tenantId])
  @@map("totems")
}

model CashSession {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  /// Igual ao tenantId enquanto o caixa está aberto: um caixa aberto por restaurante.
  openKey         String?           @unique @map("open_key") @db.Uuid
  status          CashSessionStatus @default(OPEN)
  openingCents    Int               @map("opening_cents")
  openedById      String?           @map("opened_by_id") @db.Uuid
  openedByName    String?           @map("opened_by_name")
  openedAt        DateTime          @default(now()) @map("opened_at")
  closedById      String?           @map("closed_by_id") @db.Uuid
  closedByName    String?           @map("closed_by_name")
  closedAt        DateTime?         @map("closed_at")
  /// No fechamento: o que tinha na gaveta, o que deveria ter e a diferença (contado − esperado).
  countedCents    Int?              @map("counted_cents")
  expectedCents   Int?              @map("expected_cents")
  differenceCents Int?              @map("difference_cents")
  notes           String?
  /// Resumo congelado no fechamento (vendas por forma de pagamento, sangrias...).
  summary         Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements       CashMovement[]
  payments        CounterPayment[]

  @@index([tenantId, openedAt])
  @@map("cash_sessions")
}

enum CashMovementKind {
  /// Retirada de dinheiro da gaveta (ex.: levar ao cofre, pagar um fornecedor).
  SANGRIA
  /// Dinheiro colocado na gaveta (ex.: mais troco).
  SUPRIMENTO
}

model CashMovement {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  sessionId   String           @map("session_id") @db.Uuid
  kind        CashMovementKind
  amountCents Int              @map("amount_cents")
  reason      String?
  userId      String?          @map("user_id") @db.Uuid
  userName    String?          @map("user_name")
  createdAt   DateTime         @default(now()) @map("created_at")
  session     CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("cash_movements")
}

/// Pagamento de uma venda de balcão (uma venda pode ser paga com várias formas).
model CounterPayment {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  sessionId     String?       @map("session_id") @db.Uuid
  method        PaymentMethod
  /// Cartão na maquininha: CREDIT ou DEBIT (para a nota fiscal).
  cardKind      String?       @map("card_kind")
  /// Valor abatido da venda.
  amountCents   Int           @map("amount_cents")
  /// Dinheiro: quanto o cliente entregou e o troco devolvido (recebido − valor).
  receivedCents Int?          @map("received_cents")
  changeCents   Int           @default(0) @map("change_cents")
  /// Rateio entre clientes: de quem é este pagamento (ex.: "Ana", "Cliente 2").
  label         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  session       CashSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sessionId])
  @@map("counter_payments")
}

// =====================================================================
// Nota fiscal de consumidor (NFC-e)
// =====================================================================

/// Dados fiscais do restaurante para emitir NFC-e (o emissor manda para a SEFAZ).
model FiscalSettings {
  tenantId          String   @id @map("tenant_id") @db.Uuid
  enabled           Boolean  @default(false)
  /// Emissor: "simulado" por enquanto (o emissor real entra depois).
  provider          String   @default("simulado")
  /// HOMOLOGACAO (teste, sem valor fiscal) ou PRODUCAO.
  environment       String   @default("HOMOLOGACAO")
  cnpj              String?
  stateRegistration String?  @map("state_registration")
  legalName         String?  @map("legal_name")
  /// UF do restaurante (ex.: "SP"): entra na chave de acesso.
  uf                String?
  /// 1 = Simples Nacional, 2 = Simples (excesso de sublimite), 3 = Regime normal.
  taxRegime         Int      @default(1) @map("tax_regime")
  /// Código de Segurança do Contribuinte (CSC), dado pela SEFAZ para o QR Code.
  cscId             String?  @map("csc_id")
  cscTokenEncrypted String?  @map("csc_token_encrypted")
  series            Int      @default(1)
  nextNumber        Int      @default(1) @map("next_number")
  /// Padrões dos produtos sem NCM/CFOP próprios.
  defaultNcm        String   @default("21069090") @map("default_ncm")
  defaultCfop       String   @default("5102") @map("default_cfop")
  /// CSOSN (Simples) ou CST do ICMS.
  defaultCsosn      String   @default("102") @map("default_csosn")
  /// Cupom que já vem marcado no PDV: NAO_FISCAL (cupom não fiscal) ou NFCE. O caixa pode trocar em cada venda.
  pdvReceipt        String   @default("NAO_FISCAL") @map("pdv_receipt")
  updatedAt         DateTime @updatedAt @map("updated_at")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("fiscal_settings")
}

enum FiscalStatus {
  /// Mandada ao emissor, esperando a SEFAZ.
  PROCESSING
  AUTHORIZED
  /// A SEFAZ recusou (ex.: NCM inválido): dá para corrigir e emitir de novo.
  REJECTED
  CANCELLED
}

model FiscalDocument {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  /// Referência única mandada ao emissor (evita nota em dobro se a chamada repetir).
  ref          String       @unique
  provider     String
  environment  String
  status       FiscalStatus
  series       Int
  number       Int
  accessKey    String?      @map("access_key")
  protocol     String?
  qrCodeUrl    String?      @map("qr_code_url")
  consultUrl   String?      @map("consult_url")
  /// CPF/CNPJ do consumidor na nota.
  document     String?
  totalCents   Int          @map("total_cents")
  message      String?
  authorizedAt DateTime?    @map("authorized_at")
  cancelledAt  DateTime?    @map("cancelled_at")
  cancelReason String?      @map("cancel_reason")
  /// O que foi mandado ao emissor (itens, pagamentos), para conferência.
  payload      Json
  createdAt    DateTime     @default(now()) @map("created_at")
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, environment, series, number])
  @@index([orderId])
  @@index([tenantId, createdAt])
  @@map("fiscal_documents")
}

model IfoodCatalogLink {
  tenantId   String @map("tenant_id") @db.Uuid
  kind       String
  externalId String @map("external_id")
  localId    String @map("local_id") @db.Uuid
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, kind, externalId])
  @@unique([tenantId, kind, localId])
  @@map("ifood_catalog_links")
}
