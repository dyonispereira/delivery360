// Núcleo (core) do Delivery360: restaurantes (tenants), módulos, planos, usuários,
// auditoria e fila de eventos entre módulos.
// Regra: toda tabela de negócio dos módulos terá a coluna tenant_id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum StaffRole {
  SUPER_ADMIN
  ACCOUNT_MANAGER
}

enum TenantRole {
  OWNER
  MANAGER
  STAFF
}

/// Restaurante cliente. Cada um é isolado dos demais.
model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  legalName String?      @map("legal_name")
  cnpj      String?      @unique
  phone     String?
  email     String?
  status    TenantStatus @default(ACTIVE)
  planId    String?      @map("plan_id") @db.Uuid
  plan      Plan?        @relation(fields: [planId], references: [id])
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  modules         TenantModule[]
  memberships     Membership[]
  accountManagers AccountManagerTenant[]
  auditLogs       AuditLog[]
  events          DomainEvent[]

  store            Store?
  paymentAccount   PaymentAccount?
  deliveryZones    DeliveryZone[]
  menuCategories   MenuCategory[]
  products         Product[]
  customers        Customer[]
  orders           Order[]
  couriers         Courier[]
  deliveryBatches  DeliveryBatch[]
  accounts         Account[]
  financialEntries FinancialEntry[]
  financeSettings  FinanceSettings?
  channelSettings  ChannelSetting[]
  employees        Employee[]
  payrolls         Payroll[]
  coupons          Coupon[]

  @@map("tenants")
}

/// Catálogo de módulos (gestao, cardapio, entregas, trafego).
model Module {
  code        String  @id
  name        String
  description String?

  plans   PlanModule[]
  tenants TenantModule[]

  @@map("modules")
}

/// Plano comercial = pacote de módulos.
model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  modules PlanModule[]
  tenants Tenant[]

  @@map("plans")
}

model PlanModule {
  planId     String @map("plan_id") @db.Uuid
  moduleCode String @map("module_code")
  plan       Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module     Module @relation(fields: [moduleCode], references: [code])

  @@id([planId, moduleCode])
  @@map("plan_modules")
}

/// A "chave" de cada módulo por restaurante. Desligar não apaga dados.
model TenantModule {
  tenantId   String    @map("tenant_id") @db.Uuid
  moduleCode String    @map("module_code")
  active     Boolean   @default(true)
  startsAt   DateTime? @map("starts_at")
  /// Fim opcional (ex.: período de teste).
  endsAt     DateTime? @map("ends_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module     Module    @relation(fields: [moduleCode], references: [code])

  @@id([tenantId, moduleCode])
  @@map("tenant_modules")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  /// Papel na nossa equipe; null para usuários de restaurante.
  staffRole    StaffRole? @map("staff_role")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships    Membership[]
  managedTenants AccountManagerTenant[]
  auditLogs      AuditLog[]

  @@map("users")
}

/// Vínculo de um usuário com um restaurante.
model Membership {
  userId    String     @map("user_id") @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  role      TenantRole
  createdAt DateTime   @default(now()) @map("created_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@map("memberships")
}

/// Carteira do gestor de conta: quais restaurantes ele atende.
model AccountManagerTenant {
  userId   String @map("user_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@map("account_manager_tenants")
}

/// Quem alterou o quê, quando e em qual restaurante.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// Fila de eventos entre módulos (ex.: pedido.entregue -> lançamento no financeiro).
model DomainEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([processedAt, createdAt])
  @@map("domain_events")
}

// =====================================================================
// Módulo Cardápio e pedidos (Sprint 1): cardápio, loja online, pedidos
// Valores em centavos (inteiros) para não ter erro de arredondamento.
// =====================================================================

enum OrderType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  IN_PREPARATION
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  CASH_ON_DELIVERY
  CARD_ON_DELIVERY
  /// Pago dentro do app de delivery (iFood, 99Food, Keeta); o app repassa depois.
  APP_ONLINE
}

/// Canal de venda: loja própria ou app de delivery.
enum SalesChannel {
  LOJA
  IFOOD
  FOOD99
  KEETA
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

/// Configuração da loja online do restaurante (1 por restaurante).
model Store {
  tenantId         String          @id @map("tenant_id") @db.Uuid
  /// Endereço público: /loja/<slug>
  slug             String          @unique
  displayName      String          @map("display_name")
  description      String?
  logoUrl          String?         @map("logo_url")
  /// Foto de capa no topo da loja online.
  coverUrl         String?         @map("cover_url")
  whatsapp         String?
  /// Cidade e UF (ex.: "Campinas - SP"), usada na rota do motoboy.
  city             String?
  isOpen           Boolean         @default(false) @map("is_open")
  acceptsDelivery  Boolean         @default(true) @map("accepts_delivery")
  acceptsPickup    Boolean         @default(true) @map("accepts_pickup")
  minOrderCents    Int             @default(0) @map("min_order_cents")
  /// Formas de pagamento aceitas (lista de PaymentMethod).
  paymentMethods   PaymentMethod[] @default([PIX, CASH_ON_DELIVERY, CARD_ON_DELIVERY]) @map("payment_methods")
  estimatedMinutes Int             @default(40) @map("estimated_minutes")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("stores")
}

/// Taxa de entrega por bairro.
model DeliveryZone {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  feeCents Int     @map("fee_cents")
  active   Boolean @default(true)
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("delivery_zones")
}

model MenuCategory {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  position  Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]

  @@index([tenantId, position])
  @@map("menu_categories")
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  name          String
  description   String?
  priceCents    Int           @map("price_cents")
  imageUrl      String?       @map("image_url")
  position      Int           @default(0)
  /// Some da loja (ex.: fora do cardápio).
  active        Boolean       @default(true)
  /// Esgotado no momento: aparece, mas não pode ser pedido.
  available     Boolean       @default(true)
  /// Código PDV: o mesmo em todos os canais (loja, iFood, 99Food, Keeta) para reconhecer o item.
  pdvCode       String?       @map("pdv_code")
  /// Preço em cada app, em centavos ({ "IFOOD": 3290 }). Sem preço = mesmo da loja.
  channelPrices Json          @default("{}") @map("channel_prices")
  /// Ficha técnica: [{ name, kind: INGREDIENT|PACKAGING|OTHER, costCents }] por unidade.
  costItems     Json          @default("[]") @map("cost_items")
  /// Outras despesas variáveis só deste produto (pontos-base, 100 = 1%).
  extraCostBps  Int           @default(0) @map("extra_cost_bps")
  /// Preço de/por: preço promocional e período (vazio = sem promoção; sem datas = vale até tirar).
  promoPriceCents Int?        @map("promo_price_cents")
  promoStartsAt   DateTime?   @map("promo_starts_at")
  promoEndsAt     DateTime?   @map("promo_ends_at")
  /// Combo: as etapas são os grupos de opções e cada opção pode apontar para um produto do cardápio.
  isCombo       Boolean       @default(false) @map("is_combo")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      MenuCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  optionGroups  OptionGroup[]
  /// Opções de combos que apontam para este produto.
  comboOptions  Option[]      @relation("ComboOptionProduct")

  @@unique([tenantId, pdvCode])
  @@index([tenantId, categoryId, position])
  @@map("products")
}

/// Grupo de adicionais de um produto (ex.: "Escolha a borda", mín. 1, máx. 1).
model OptionGroup {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  name      String
  minSelect Int      @default(0) @map("min_select")
  maxSelect Int      @default(1) @map("max_select")
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  options   Option[]

  @@map("option_groups")
}

model Option {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  groupId    String      @map("group_id") @db.Uuid
  name       String
  priceCents Int         @default(0) @map("price_cents")
  /// Custo do adicional (ex.: bacon extra R$ 1,50), soma no CMV da venda.
  costCents  Int         @default(0) @map("cost_cents")
  /// Código PDV do adicional (pode repetir em produtos diferentes).
  pdvCode    String?     @map("pdv_code")
  available  Boolean     @default(true)
  position   Int         @default(0)
  /// No combo: o produto do cardápio que esta opção representa (segue a disponibilidade e o custo dele).
  linkedProductId String?  @map("linked_product_id") @db.Uuid
  linkedProduct   Product? @relation("ComboOptionProduct", fields: [linkedProductId], references: [id], onDelete: Cascade)
  group      OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([linkedProductId])

  @@map("options")
}

/// Cliente final que pediu pela loja online (por restaurante, identificado pelo telefone).
model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// Só dígitos, com DDD (ex.: 11987654321).
  phone     String
  /// CPF ou CNPJ, só dígitos (o Asaas exige para gerar o Pix).
  document  String?
  /// Id do cliente na conta Asaas do restaurante (para não cadastrar de novo).
  gatewayCustomerId String? @map("gateway_customer_id")
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@unique([tenantId, phone])
  @@map("customers")
}

model Order {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  /// Número curto por restaurante, para falar com o cliente e imprimir.
  number            Int
  /// Código secreto da página de acompanhamento (/pedido/<trackingCode>).
  trackingCode      String               @unique @map("tracking_code")
  customerId        String               @map("customer_id") @db.Uuid
  type              OrderType
  status            OrderStatus
  customerName      String               @map("customer_name")
  customerPhone     String               @map("customer_phone")
  addressStreet     String?              @map("address_street")
  addressNumber     String?              @map("address_number")
  addressComplement String?              @map("address_complement")
  addressReference  String?              @map("address_reference")
  deliveryZoneId    String?              @map("delivery_zone_id") @db.Uuid
  deliveryZoneName  String?              @map("delivery_zone_name")
  notes             String?
  subtotalCents     Int                  @map("subtotal_cents")
  deliveryFeeCents  Int                  @map("delivery_fee_cents")
  discountCents     Int                  @default(0) @map("discount_cents")
  /// Cupom usado (loja própria). O desconto do cupom fica em discountCents.
  couponId          String?              @map("coupon_id") @db.Uuid
  couponCode        String?              @map("coupon_code")
  /// Quem pagou o desconto do cupom (congelado no pedido). RESTAURANT no cupom da loja; na campanha da rede, conforme a divisão.
  couponFundedBy    CouponFunding?       @map("coupon_funded_by")
  coupon            Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  /// Cupom de campanha da rede (o código fica em couponCode e o desconto inteiro em discountCents).
  campaignId        String?              @map("campaign_id") @db.Uuid
  campaign          Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /// Parte de discountCents bancada pela Delivery360 (campanha mista ou 100% nossa).
  couponPlatformCents Int                @default(0) @map("coupon_platform_cents")
  /// Impulso Delivery360: desconto automático bancado pela Delivery360 (soma com o cupom do restaurante).
  platformDiscountCents Int              @default(0) @map("platform_discount_cents")
  platformCouponId  String?              @map("platform_coupon_id") @db.Uuid
  platformCoupon    Coupon?              @relation("PlatformBoost", fields: [platformCouponId], references: [id], onDelete: SetNull)
  /// Quanto o cliente economizou com preço de/por (já fora do subtotal). Vai para "Descontos e cupons" no DRE.
  promoDiscountCents Int                 @default(0) @map("promo_discount_cents")
  totalCents        Int                  @map("total_cents")
  paymentMethod     PaymentMethod        @map("payment_method")
  /// De onde veio o pedido (loja própria ou app de delivery).
  channel           SalesChannel         @default(LOJA)
  /// Id do pedido no app de delivery (evita importar duas vezes).
  externalId        String?              @map("external_id")
  /// Número do pedido mostrado pelo app (ex.: "#4821" no iFood).
  externalCode      String?              @map("external_code")
  /// Código de entrega informado pelo app (no lugar dos 4 últimos dígitos do telefone).
  deliveryCode      String?              @map("delivery_code")
  /// Troco para quanto (dinheiro na entrega).
  changeForCents    Int?                 @map("change_for_cents")
  utmSource         String?              @map("utm_source")
  utmCampaign       String?              @map("utm_campaign")
  /// Primeira impressão do pedido (evita imprimir de novo em outra tela).
  printedAt         DateTime?            @map("printed_at")
  /// Lote de entrega (motoboy) em que o pedido saiu.
  batchId           String?              @map("batch_id") @db.Uuid
  batch             DeliveryBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  deliveredAt       DateTime?            @map("delivered_at")
  /// Tentativas erradas do código de 4 dígitos (trava em 5).
  deliveryCodeFails Int                  @default(0) @map("delivery_code_fails")
  /// Última ocorrência ainda não resolvida (o motoboy não conseguiu entregar). Some quando o pedido sai de novo.
  deliveryIssue     DeliveryFailReason?  @map("delivery_issue")
  deliveryIssueAt   DateTime?            @map("delivery_issue_at")
  /// Avaliação do cliente depois de receber (1 a 5 estrelas; 5 = excelente). Uma vez só.
  ratingStore       Int?                 @map("rating_store")
  ratingDelivery    Int?                 @map("rating_delivery")
  ratingComment     String?              @map("rating_comment")
  ratedAt           DateTime?            @map("rated_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer             @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  payments          Payment[]
  deliveryAttempts  DeliveryAttempt[]
  tip               Tip?

  @@unique([tenantId, number])
  @@unique([tenantId, channel, externalId])
  @@index([tenantId, status, createdAt])
  @@index([batchId])
  @@index([couponId])
  @@index([platformCouponId])
  @@index([campaignId])
  @@map("orders")
}

/// Item do pedido com nome e preço copiados no momento da compra (o cardápio pode mudar depois).
model OrderItem {
  id             String            @id @default(uuid()) @db.Uuid
  orderId        String            @map("order_id") @db.Uuid
  productId      String?           @map("product_id") @db.Uuid
  name           String
  unitPriceCents Int               @map("unit_price_cents")
  quantity       Int
  notes          String?
  totalCents     Int               @map("total_cents")
  /// Custo unitário pela ficha técnica no momento da venda (CMV teórico).
  unitCostCents  Int               @default(0) @map("unit_cost_cents")
  /// Preço unitário sem a promoção (igual ao unitPriceCents quando não havia promoção).
  listUnitPriceCents Int?          @map("list_unit_price_cents")
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  options        OrderItemOption[]

  @@map("order_items")
}

model OrderItemOption {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  optionId    String?   @map("option_id") @db.Uuid
  groupName   String    @map("group_name")
  name        String
  priceCents  Int       @map("price_cents")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_item_options")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  /// null = sistema (ex.: webhook do pagamento).
  userId    String?     @map("user_id") @db.Uuid
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  /// "fake" (desenvolvimento), "offline" (pagar na entrega) ou o gateway real.
  provider     String
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  amountCents  Int           @map("amount_cents")
  feeCents     Int           @default(0) @map("fee_cents")
  /// Id do pagamento no gateway.
  externalId   String?       @map("external_id")
  /// PIX copia e cola (quando houver).
  pixCopyPaste String?       @map("pix_copy_paste")
  /// QR Code do Pix em PNG (base64), quando o gateway manda a imagem.
  pixQrImage   String?       @map("pix_qr_image")
  expiresAt    DateTime?     @map("expires_at")
  paidAt       DateTime?     @map("paid_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@map("payments")
}

/// Conta do gateway de pagamento do restaurante (Asaas): o Pix cai direto nela.
/// A chave da API fica cifrada e nunca volta para o navegador.
model PaymentAccount {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  provider        String   @default("asaas")
  sandbox         Boolean  @default(false)
  apiKeyEncrypted String   @map("api_key_encrypted")
  apiKeyLast4     String   @map("api_key_last4")
  accountName     String?  @map("account_name")
  /// Token que o Asaas manda no header asaas-access-token de cada webhook.
  webhookToken    String   @map("webhook_token")
  webhookId       String?  @map("webhook_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payment_accounts")
}

// ---------- Entregas ----------

enum BatchStatus {
  OUT
  DONE
  CANCELLED
}

/// Motoboy cadastrado pelo restaurante. Entra na tela do entregador por um link secreto.
model Courier {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  name           String
  phone          String
  /// Quanto o restaurante paga por entrega (vai para a Gestão como custo).
  feeCents       Int               @default(0) @map("fee_cents")
  active         Boolean           @default(true)
  /// Token do link /entregador/<token>; trocar o token derruba o link antigo.
  accessToken    String            @unique @map("access_token")
  /// Última posição enviada pelo celular do motoboy (só durante entregas).
  lastLat        Float?            @map("last_lat")
  lastLng        Float?            @map("last_lng")
  lastAccuracy   Float?            @map("last_accuracy")
  lastLocationAt DateTime?         @map("last_location_at")
  /// Placa da moto (aparece no registro de cada entrega).
  plate          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batches        DeliveryBatch[]
  attempts       DeliveryAttempt[]
  tips           Tip[]

  @@index([tenantId])
  @@map("couriers")
}

/// Lote: pedidos que saem juntos com um motoboy.
model DeliveryBatch {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  number     Int
  courierId  String      @map("courier_id") @db.Uuid
  status     BatchStatus @default(OUT)
  createdBy  String?     @map("created_by") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")
  finishedAt DateTime?   @map("finished_at")
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courier    Courier     @relation(fields: [courierId], references: [id])
  orders     Order[]

  @@unique([tenantId, number])
  @@index([courierId, status])
  @@map("delivery_batches")
}

enum DeliveryOutcome {
  DELIVERED
  FAILED
}

enum DeliveryFailReason {
  /// Endereço não localizado.
  ADDRESS_NOT_FOUND
  /// Cliente não atende / ninguém no local (ex.: dormindo).
  CUSTOMER_ABSENT
  /// Cliente recusou ou não quer mais o pedido.
  CUSTOMER_REFUSED
  OTHER
}

/// Registro de cada tentativa de entrega (entregue ou ocorrência). O motoboy não altera depois;
/// só o restaurante corrige (com auditoria). Guarda cópia do nome e da placa do motoboy no momento.
model DeliveryAttempt {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  orderId      String              @map("order_id") @db.Uuid
  courierId    String              @map("courier_id") @db.Uuid
  batchId      String?             @map("batch_id") @db.Uuid
  batchNumber  Int?                @map("batch_number")
  outcome      DeliveryOutcome
  failReason   DeliveryFailReason? @map("fail_reason")
  note         String?
  receiverName String?             @map("receiver_name")
  /// Código de 4 dígitos conferido na entrega.
  code         String?
  courierName  String              @map("courier_name")
  courierPlate String?             @map("courier_plate")
  /// Onde o celular do motoboy estava (se tinha sinal recente).
  lat          Float?
  lng          Float?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier      Courier             @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([courierId, createdAt])
  @@index([tenantId, createdAt])
  @@map("delivery_attempts")
}

/// Gorjeta do cliente para o motoboy. Entra no caixa do restaurante, que repassa ao motoboy como prêmio.
/// Não é receita do restaurante: na Gestão entra como valor a repassar.
model Tip {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  orderId      String        @unique @map("order_id") @db.Uuid
  courierId    String        @map("courier_id") @db.Uuid
  amountCents  Int           @map("amount_cents")
  provider     String
  status       PaymentStatus @default(PENDING)
  externalId   String?       @map("external_id")
  pixCopyPaste String?       @map("pix_copy_paste")
  /// QR Code do Pix em PNG (base64), quando o gateway manda a imagem.
  pixQrImage   String?       @map("pix_qr_image")
  expiresAt    DateTime?     @map("expires_at")
  paidAt       DateTime?     @map("paid_at")
  /// Quando o restaurante entregou o dinheiro ao motoboy.
  paidOutAt    DateTime?     @map("paid_out_at")
  paidOutBy    String?       @map("paid_out_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier      Courier       @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([tenantId, status, paidOutAt])
  @@index([courierId])
  @@map("tips")
}

// ---------- Módulo Gestão: financeiro ----------

enum AccountKind {
  /// Receita bruta (grupo 1)
  REVENUE
  /// Deduções da receita (grupo 2)
  DEDUCTION
  /// CMV e despesas operacionais (grupos 3 a 8)
  EXPENSE
  /// Resultado financeiro (grupo 9): juros, tarifas, rendimentos
  FINANCIAL
  /// Fora da DRE (grupos 10 e 11): investimentos, retiradas, valores de terceiros
  OFF_DRE
}

/// Plano de contas do restaurante (vem pronto e pode ganhar contas novas).
model Account {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  /// "6.1"
  code      String
  group     Int
  name      String
  kind      AccountKind
  /// Conta padrão do sistema (lançamentos automáticos usam). Pode ser renomeada, não excluída.
  system    Boolean          @default(false)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries   FinancialEntry[]

  @@unique([tenantId, code])
  @@map("accounts")
}

enum EntryType {
  RECEIVABLE
  PAYABLE
}

enum EntryStatus {
  OPEN
  PAID
  CANCELLED
}

/// Conta a pagar ou a receber. A DRE usa a data de competência; o caixa usa a data do pagamento.
model FinancialEntry {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  type           EntryType
  accountId      String        @map("account_id") @db.Uuid
  description    String
  counterparty   String?
  amountCents    Int           @map("amount_cents")
  competenceDate DateTime      @map("competence_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  status         EntryStatus   @default(OPEN)
  paidAt         DateTime?     @map("paid_at") @db.Date
  notes          String?
  /// Forma de pagamento informada pelo cliente (vendas).
  paymentMethod  String?       @map("payment_method")
  /// Canal de venda do pedido que gerou o lançamento (loja, iFood, 99Food, Keeta).
  channel        SalesChannel?
  /// "manual" ou o módulo que gerou (cardapio, entregas...).
  source         String        @default("manual")
  /// Chave do lançamento automático (evita duplicar se o evento for processado de novo).
  externalKey    String?       @map("external_key")
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account        Account       @relation(fields: [accountId], references: [id])

  @@unique([tenantId, externalKey])
  @@index([tenantId, type, status, dueDate])
  @@index([tenantId, competenceDate])
  @@map("financial_entries")
}

/// Impostos e taxas do restaurante (pontos-base, 100 = 1%). Usados na ficha técnica e nos lançamentos das vendas.
model FinanceSettings {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  salesTaxBps          Int      @default(0) @map("sales_tax_bps")
  pixFeeBps            Int      @default(0) @map("pix_fee_bps")
  creditFeeBps         Int      @default(0) @map("credit_fee_bps")
  cardOnDeliveryFeeBps Int      @default(0) @map("card_on_delivery_fee_bps")
  targetMarginBps      Int      @default(2000) @map("target_margin_bps")
  /// Dia do mês em que o imposto vence (mês seguinte à venda).
  taxDueDay            Int      @default(20) @map("tax_due_day")
  /// Encargos sobre a folha CLT pagos pelo restaurante: FGTS (8%) e INSS patronal (0% no Simples, anexos I a III).
  fgtsBps              Int      @default(800) @map("fgts_bps")
  employerInssBps      Int      @default(0) @map("employer_inss_bps")
  /// Dia do pagamento do salário no mês seguinte (ex.: 5).
  payDay               Int      @default(5) @map("pay_day")
  updatedAt            DateTime @updatedAt @map("updated_at")
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("finance_settings")
}

/// Configuração de cada app de delivery do restaurante (comissão, taxa e prazo de repasse).
model ChannelSetting {
  tenantId      String       @map("tenant_id") @db.Uuid
  channel       SalesChannel
  active        Boolean      @default(false)
  /// Código da loja no app (merchant id).
  merchantId    String?      @map("merchant_id")
  commissionBps Int          @default(0) @map("commission_bps")
  paymentFeeBps Int          @default(0) @map("payment_fee_bps")
  payoutDays    Int          @default(30) @map("payout_days")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, channel])
  @@map("channel_settings")
}

// ---------- Gestão de pessoas ----------

/// Tipo de contratação (folha gerencial: não substitui o eSocial do contador).
enum EmploymentType {
  CLT
  PJ
  /// Diarista / freelancer: recebe por dia trabalhado.
  DIARISTA
  ESTAGIO
}

/// Funcionário do restaurante.
model Employee {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  name            String
  /// Cargo (ex.: cozinheiro, atendente, pizzaiolo).
  role            String
  type            EmploymentType
  phone           String?
  document        String?
  pixKey          String?        @map("pix_key")
  /// Salário mensal (CLT, PJ, estágio).
  salaryCents     Int            @default(0) @map("salary_cents")
  /// Valor da diária (diarista).
  dailyRateCents  Int            @default(0) @map("daily_rate_cents")
  /// Vale-transporte e vale-alimentação por mês (custo do restaurante).
  transportCents  Int            @default(0) @map("transport_cents")
  mealCents       Int            @default(0) @map("meal_cents")
  /// Folga fixa da semana: 0 = domingo ... 6 = sábado (null = sem folga fixa).
  weeklyDayOff    Int?           @map("weekly_day_off")
  admissionDate   DateTime       @map("admission_date") @db.Date
  terminationDate DateTime?      @map("termination_date") @db.Date
  active          Boolean        @default(true)
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  absences        Absence[]
  payrollItems    PayrollItem[]

  @@index([tenantId, active])
  @@map("employees")
}

enum AbsenceKind {
  /// Folga extra (além da folga fixa).
  FOLGA
  FERIAS
  ATESTADO
  /// Falta sem justificativa: desconta do salário.
  FALTA
}

/// Folga, férias, atestado ou falta, em um período (dias inteiros).
model Absence {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  employeeId String      @map("employee_id") @db.Uuid
  kind       AbsenceKind
  startDate  DateTime    @map("start_date") @db.Date
  endDate    DateTime    @map("end_date") @db.Date
  notes      String?
  createdAt  DateTime    @default(now()) @map("created_at")
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, startDate])
  @@map("absences")
}

enum PayrollStatus {
  DRAFT
  CLOSED
}

/// Folha gerencial do mês. Fechar gera as contas a pagar (grupo 4) e entra na DRE.
model Payroll {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  /// "2026-11"
  month     String
  status    PayrollStatus @default(DRAFT)
  closedAt  DateTime?     @map("closed_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     PayrollItem[]

  @@unique([tenantId, month])
  @@map("payrolls")
}

/// Linha da folha por funcionário (valores em centavos).
model PayrollItem {
  id             String   @id @default(uuid()) @db.Uuid
  payrollId      String   @map("payroll_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  /// Salário do mês (proporcional se entrou ou saiu no meio) ou diárias.
  baseCents      Int      @map("base_cents")
  /// Dias trabalhados (diarista) ou dias de salário no mês.
  days           Int
  /// Horas extras, adicional noturno, comissão.
  extrasCents    Int      @default(0) @map("extras_cents")
  /// Prêmio / bonificação.
  bonusCents     Int      @default(0) @map("bonus_cents")
  /// Faltas descontadas (automático).
  absenceCents   Int      @default(0) @map("absence_cents")
  absenceDays    Int      @default(0) @map("absence_days")
  /// Adiantamentos e outros descontos.
  advanceCents   Int      @default(0) @map("advance_cents")
  /// Vale-transporte + vale-alimentação.
  benefitsCents  Int      @default(0) @map("benefits_cents")
  /// Encargos do restaurante (FGTS e INSS patronal, conforme configuração).
  chargesCents   Int      @default(0) @map("charges_cents")
  /// Provisão de férias + 1/3 e 13º (reserva mensal).
  provisionCents Int      @default(0) @map("provision_cents")
  /// A pagar ao funcionário.
  netCents       Int      @map("net_cents")
  notes          String?
  payroll        Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollId, employeeId])
  @@map("payroll_items")
}

enum CouponFunding {
  RESTAURANT
  PLATFORM
  MIXED
}

/// Campanha da rede, criada pela equipe Delivery360: banner nas lojas participantes e, se tiver código,
/// um cupom que o cliente usa em qualquer uma delas. O custo do desconto se divide entre a Delivery360 e o restaurante.
model Campaign {
  id                 String     @id @default(uuid()) @db.Uuid
  title              String
  subtitle           String?
  imageUrl           String     @map("image_url")
  /// Lojas da campanha. Vazio = todas.
  tenantIds          String[]   @default([]) @map("tenant_ids")
  /// Lojas que saíram (só pode sair quando o restaurante banca parte do cupom).
  optedOutTenantIds  String[]   @default([]) @map("opted_out_tenant_ids")
  startsAt           DateTime?  @map("starts_at")
  endsAt             DateTime?  @map("ends_at")
  active             Boolean    @default(true)
  position           Int        @default(0)
  /// Código do cupom da campanha. Sem código = só banner.
  couponCode         String?    @unique @map("coupon_code")
  type               CouponType @default(PERCENT)
  /// PERCENT: pontos-base (1000 = 10%). FIXED: centavos. FREE_DELIVERY: 0.
  value              Int        @default(0)
  maxDiscountCents   Int?       @map("max_discount_cents")
  minOrderCents      Int        @default(0) @map("min_order_cents")
  weekdays           Int[]      @default([])
  /// Limite de usos somando todas as lojas.
  maxUses            Int?       @map("max_uses")
  maxUsesPerCustomer Int?       @default(1) @map("max_uses_per_customer")
  firstOrderOnly     Boolean    @default(false) @map("first_order_only")
  combinesWithPromo  Boolean    @default(false) @map("combines_with_promo")
  /// Parte do desconto bancada pela Delivery360, em pontos-base (10000 = 100% nossa; 0 = 100% do restaurante).
  platformShareBps   Int        @default(10000) @map("platform_share_bps")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  orders             Order[]

  @@map("campaigns")
}

enum CouponType {
  /// Percentual sobre os produtos.
  PERCENT
  /// Valor fixo em reais.
  FIXED
  /// Entrega grátis (desconta a taxa do bairro).
  FREE_DELIVERY
}

/// Cupom de desconto da loja própria.
model Coupon {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  /// Sempre em maiúsculas, sem espaços (ex.: VOLTEI15).
  code               String
  description        String?
  type               CouponType
  /// PERCENT: pontos-base (1000 = 10%). FIXED: centavos. FREE_DELIVERY: 0.
  value              Int        @default(0)
  /// Teto do desconto (só no percentual).
  maxDiscountCents   Int?       @map("max_discount_cents")
  minOrderCents      Int        @default(0) @map("min_order_cents")
  startsAt           DateTime?  @map("starts_at")
  endsAt             DateTime?  @map("ends_at")
  /// Dias da semana em que vale (0 = domingo). Vazio = todos.
  weekdays           Int[]      @default([])
  maxUses            Int?       @map("max_uses")
  maxUsesPerCustomer Int?       @default(1) @map("max_uses_per_customer")
  firstOrderOnly     Boolean    @default(false) @map("first_order_only")
  /// Vale também sobre produtos em preço de/por.
  combinesWithPromo  Boolean    @default(false) @map("combines_with_promo")
  /// Só vale para estes produtos ou combos (vazio = pedido inteiro).
  productIds         String[]   @default([]) @map("product_ids")
  /// Quem paga o desconto. PLATFORM = impulso Delivery360: criado pela nossa equipe, entra sozinho
  /// (sem código) nos pedidos que se encaixam e soma com o cupom do restaurante. O restaurante
  /// recebe o valor da Delivery360 e não pode alterar o impulso.
  fundedBy           CouponFunding @default(RESTAURANT) @map("funded_by")
  /// Aparece na faixa de cupons da loja (falso = só quem tem o código).
  public             Boolean    @default(false)
  active             Boolean    @default(true)
  createdAt          DateTime   @default(now()) @map("created_at")
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders             Order[]
  boostedOrders      Order[]    @relation("PlatformBoost")

  @@unique([tenantId, code])
  @@map("coupons")
}
