DATABASE_URL="postgresql://delivery:delivery@localhost:5432/delivery360?schema=public"
JWT_SECRET="troque-esta-chave-em-producao"
JWT_EXPIRES_IN="12h"
PORT=3333
CORS_ORIGIN="http://localhost:3000"
# Usuário super admin criado pelo seed (apenas desenvolvimento)
SEED_ADMIN_EMAIL="admin@delivery360.local"
SEED_ADMIN_PASSWORD="admin123"
# Gateway de pagamento de teste (simula PIX). Desligue em produção.
PAYMENTS_FAKE_ENABLED="true"
# Endereço público da API (o Asaas chama <PUBLIC_API_URL>/public/webhooks/asaas/<loja>).
PUBLIC_API_URL="http://localhost:3333"
# Cifra as chaves do Asaas no banco (se vazio, usa JWT_SECRET). Não trocar depois de conectar contas.
PAYMENTS_SECRET=""
